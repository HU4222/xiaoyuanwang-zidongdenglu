<?xml version="1.0" encoding="utf-8"?>
<!--
    主界面：hero 光晕 → 状态卡 → 账号卡 → 主操作 → 守护卡 → 导航。
    一屏三张卡，符合 DropLink「信息密度低，一个卡片讲一件事」。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 顶部径向光晕，页面里唯一的装饰性渐变 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@drawable/bg_hero_glow" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/heroBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/pageH"
            android:paddingTop="@dimen/space24"
            android:paddingEnd="@dimen/pageH"
            android:paddingBottom="@dimen/space24">

            <TextView
                style="@style/TextHero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_title" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space6"
                android:text="@string/app_subtitle"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <!-- ============ 状态卡 ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardCampusNet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space18">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/cardPadH"
                    android:paddingTop="@dimen/cardPadV"
                    android:paddingEnd="@dimen/cardPadH"
                    android:paddingBottom="@dimen/cardPadV">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- 状态点 + ping 脉冲外圈 -->
                        <FrameLayout
                            android:layout_width="14dp"
                            android:layout_height="14dp">

                            <View
                                android:id="@+id/dotPing"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_ping_ok"
                                android:visibility="gone" />

                            <View
                                android:id="@+id/dotStatus"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_dot_idle" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvState"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space10"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="未启动"
                            android:textColor="@color/text"
                            android:textSize="17sp"
                            android:textFontWeight="650" />

                        <TextView
                            android:id="@+id/tvMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_soft"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="@dimen/space10"
                            android:paddingTop="@dimen/space3"
                            android:paddingEnd="@dimen/space10"
                            android:paddingBottom="@dimen/space3"
                            android:text=""
                            android:textColor="@color/text2"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space10"
                        android:lineSpacingExtra="@dimen/space3"
                        android:text="填写账号后点「检测网络」，确认能识别到你的认证系统"
                        android:textColor="@color/text2"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="@dimen/space14"
                        android:background="@drawable/bg_divider_dashed" />

                    <!-- kv 键值行：左灰右黑 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/space10"
                        android:paddingBottom="@dimen/space10"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextKvKey"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="认证方式" />

                        <TextView
                            android:id="@+id/tvKvProvider"
                            style="@style/TextKvVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@drawable/bg_divider_dashed" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/space10"
                        android:paddingBottom="@dimen/space10"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextKvKey"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="心跳间隔" />

                        <TextView
                            android:id="@+id/tvKvInterval"
                            style="@style/TextKvVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@drawable/bg_divider_dashed" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/space10"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextKvKey"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="上次结果" />

                        <TextView
                            android:id="@+id/tvLast"
                            style="@style/TextKvVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 账号 ============ -->
            <TextView
                style="@style/TextSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="账号" />

            <com.google.android.material.card.MaterialCardView
                style="@style/CardCampusNet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/cardPadH"
                    android:paddingTop="@dimen/cardPadV"
                    android:paddingEnd="@dimen/cardPadH"
                    android:paddingBottom="@dimen/cardPadV">

                    <TextView
                        style="@style/TextLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:text="用户名 / 学号" />

                    <EditText
                        android:id="@+id/etUser"
                        style="@style/InputField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="username"
                        android:hint="例如 2023110101"
                        android:inputType="text" />

                    <TextView
                        style="@style/TextLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="密码" />

                    <EditText
                        android:id="@+id/etPass"
                        style="@style/InputField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:hint="校园网密码"
                        android:inputType="textPassword" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 主按钮：渐变，页面里唯一的强强调 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                style="@style/BtnPrimary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btnH"
                android:layout_marginTop="@dimen/space12"
                android:text="立即登录" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProbe"
                style="@style/BtnGhost"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btnH"
                android:layout_marginTop="@dimen/space8"
                android:text="检测网络" />

            <!-- ============ 守护 ============ -->
            <TextView
                style="@style/TextSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="守护" />

            <com.google.android.material.card.MaterialCardView
                style="@style/CardCampusNet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/cardPadH"
                    android:paddingTop="@dimen/cardPadV"
                    android:paddingEnd="@dimen/space12"
                    android:paddingBottom="@dimen/cardPadV">

                    <ImageView
                        android:layout_width="@dimen/iconLg"
                        android:layout_height="@dimen/iconLg"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/brand" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextCardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="自动重连" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space3"
                            android:text="掉线后自动重新认证，锁屏也生效"
                            android:textColor="@color/muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swWatchdog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvWatchdogHint"
                style="@style/TextHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="" />

            <!-- 导航：列表行风格 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space12"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettings"
                    style="@style/BtnFlat"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/listRowH"
                    android:layout_marginEnd="@dimen/space8"
                    android:layout_weight="1"
                    android:text="高级设置"
                    app:icon="@drawable/ic_sliders"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space8"
                    app:iconSize="@dimen/iconMd"
                    app:iconTint="@color/text2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLog"
                    style="@style/BtnFlat"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/listRowH"
                    android:layout_weight="1"
                    android:text="运行日志"
                    app:icon="@drawable/ic_list"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space8"
                    app:iconSize="@dimen/iconMd"
                    app:iconTint="@color/text2" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space12"
                android:gravity="center"
                android:text=""
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
