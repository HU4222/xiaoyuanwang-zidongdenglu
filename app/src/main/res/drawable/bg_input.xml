<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框：panel 底 + 12dp 圆角 + 1px 描边；聚焦时描边转主色 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/panel" />
            <corners android:radius="@dimen/radiusSm" />
            <stroke android:width="1.5dp" android:color="@color/brand" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel" />
            <corners android:radius="@dimen/radiusSm" />
            <stroke android:width="@dimen/lineW" android:color="@color/lineStrong" />
        </shape>
    </item>
</selector>
